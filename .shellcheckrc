# dbx is one program split across local/lib/*.sh, sourced at runtime from a path
# built at startup. shellcheck cannot follow that, so it reads every constant a
# sibling file uses as unused and every source as unresolvable.
# SC2329 is the same artifact for functions: common.sh defines them, align.sh
# and services.sh call them.
disable=SC1091,SC2034,SC2329
